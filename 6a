
#include <stdio.h>

int main() {
    int a[10], n, i, count0 = 0, count1 = 0;

    printf("Enter number of records: ");
    scanf("%d", &n);

    printf("Enter class values (0 or 1): ");
    for(i = 0; i < n; i++) {
        scanf("%d", &a[i]);

        if(a[i] == 0)
            count0++;
        else
            count1++;
    }

    printf("ZeroR Prediction: ");

    if(count0 > count1)
        printf("Class 0");
    else
        printf("Class 1");

    return 0;
}
#output
Enter number of records: 5
Enter class values (0 or 1): 0 1 1 1 0

ZeroR Prediction: Class 1
